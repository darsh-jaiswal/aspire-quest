# Aspire Quest — environment
#
# Never commit .env.local. Pull real values with:
#   vercel env pull .env.local
#
# Every secret below is provisioned through the Vercel Marketplace, not by hand.

# --- Neon Postgres -----------------------------------------------------------
# MUST be the POOLED string (host contains "-pooler"). The direct string
# exhausts connections on serverless under registration load.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Vercel Blob (PRIVATE store — resumes) -----------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Clerk (admin + recruiter auth only; students have no accounts) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Points Clerk at this app's own branded /sign-in page (src/app/sign-in) instead
# of its generic hosted accounts.dev fallback. Without this, an unauthenticated
# /admin or /portal request redirects to Clerk's default page instead of ours.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# --- Upstash Redis (rate limiting) -------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Resend (transactional mail) ---------------------------------------------
# Free tier: 3,000/mo, 100/day. Admin + recruiter + corporate confirmations only.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Aspire Quest <noreply@example.com>"

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
